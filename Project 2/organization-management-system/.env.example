# ═══════════════════════════════════════════════════════════════════════════════
# OrgSphere Environment Configuration Template
# NOTE: Copy this file to .env before starting the application.
# NEVER commit .env files containing real secrets to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# Node Environment
NODE_ENV=development
PORT=4000

# ─── Database Options ─────────────────────────────────────────────────────────
# OPTION A (Default): Host process connecting to Docker Compose PostgreSQL
# Notice host port is 5433 to avoid collision with any local PostgreSQL service on 5432:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/orgsphere_dev?schema=public"

# OPTION B: Connecting to an existing local PostgreSQL service running on port 5432
# If using your local PostgreSQL instance, create a dedicated database 'orgsphere_dev'
# so your existing databases are untouched, and set your local password:
# DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/orgsphere_dev?schema=public"

# OPTION C: Inside Docker Compose container network (used automatically in docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/orgsphere_dev?schema=public"

# ─── Docker Compose Port Mappings ─────────────────────────────────────────────
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# ─── Redis Cache ──────────────────────────────────────────────────────────────
# Host process connecting to Redis:
REDIS_URL="redis://localhost:6379"

# ─── Authentication & Security ────────────────────────────────────────────────
# Minimum 32 characters for JWT secrets
JWT_ACCESS_SECRET="dev_jwt_access_secret_min_32_chars_long_key_!"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_min_32_chars_long_key!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Field Encryption (AES-256-GCM) ───────────────────────────────────────────
# Must be exactly 32 bytes (64 hexadecimal characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ─── Observability & Tracing ──────────────────────────────────────────────────
# Leave blank to disable OTLP exporter without crashing; spans will not be sent
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="orgsphere-api"
OTEL_DEBUG=false

# ─── Client CORS ──────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
